# Skopiuj do pliku .env i uzupełnij.
GOOGLE_PLACES_API_KEY=
# Twardy limit zapytań do Google na miesiąc — program przestaje pytać Google po jego osiągnięciu.
# 900 = margines poniżej darmowej puli (z pamięci ok. 1000/mies. dla zapytań z polami www/telefon — sprawdź w konsoli Google).
GOOGLE_MONTHLY_REQUEST_LIMIT=900
# Opcjonalnie: cena zapytania ponad darmową pulę (USD) — tylko do wyświetlania.
PLACES_PRICE_PER_REQUEST_USD=0
# Strona z opisem bota (trafia do User-Agent przy odwiedzaniu stron firm)
BOT_INFO_URL=https://twojadomena.pl/bot
MAX_RESULTS=100
PORT=8787
