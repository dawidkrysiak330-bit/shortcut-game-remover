# Sekrety Edge Functions. Skopiuj do supabase/.env (plik jest w .gitignore).
# AI wyłączone na start (płatne). Aby włączyć: AI_ENABLED=true + ANTHROPIC_API_KEY.
# AI_ENABLED=true
# ANTHROPIC_API_KEY=
# Twardy miesięczny limit zapytań do Google (darmowa pula)
GOOGLE_MONTHLY_REQUEST_LIMIT=900
GOOGLE_PLACES_API_KEY=
GUS_BIR_KEY=
# GUS_BIR_ENV=test
CEIDG_API_TOKEN=
BOT_INFO_URL=https://twojadomena.pl/bot
ALLOWED_ORIGIN=http://localhost:5173
PLACES_CONTENT_TTL_HOURS=24
# ANTHROPIC_MODEL=claude-opus-5-5
# CEIDG_API_URL=https://dane.biznes.gov.pl/api/ceidg/v2/firmy
